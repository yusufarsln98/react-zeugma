{
  "name": "react-zeugma",
  "version": "8.0.0",
  "description": "Recursive drag-and-drop dashboard layout engine — combining the tree-based splitting of react-mosaic with the declarative API of react-grid-layout. Framework-agnostic core with React bindings.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/index.d.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      },
      "default": "./dist/react.js"
    },
    "./devtools": {
      "types": "./dist/devtools.d.ts",
      "import": {
        "types": "./dist/devtools.d.ts",
        "default": "./dist/devtools.js"
      },
      "require": {
        "types": "./dist/devtools.d.cts",
        "default": "./dist/devtools.cjs"
      },
      "default": "./dist/devtools.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "author": "yusufarsln98",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusufarsln98/react-zeugma.git"
  },
  "bugs": {
    "url": "https://github.com/yusufarsln98/react-zeugma/issues"
  },
  "homepage": "https://react-zeugma.com",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "react",
    "drag-and-drop",
    "dashboard",
    "grid",
    "mosaic",
    "zeugma",
    "dnd-kit",
    "layout",
    "split-pane",
    "recursive",
    "tree",
    "panel",
    "resizable",
    "widget",
    "framework-agnostic"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src --ext ts,tsx",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "version": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.4.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.9"
  }
}
